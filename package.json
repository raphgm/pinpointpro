{
  "name": "pinpoint-pro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --port 3020 --strictPort\" \"wait-on http://localhost:3020 && cross-env VITE_DEV_SERVER_URL=http://localhost:3020 electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "@google/genai": "^1.42.0",
    "lucide-react": "^1.21.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.pinpointpro.app",
    "productName": "PinPoint Pro",
    "files": ["dist/**/*", "electron/**/*"],
    "directories": { "output": "release" },
    "mac": { "category": "public.app-category.productivity" }
  }
}
